{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KPB documentary package manifest draft v0.1 (not semantic admission)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "adva.package-manifest.draft.v0.1"
    },
    "identity": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "home": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "namespace",
        "name",
        "revision",
        "home"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "compute",
              "verify",
              "library"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_contract": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "repository",
              "commit",
              "path"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "profile",
          "source_contract"
        ],
        "additionalProperties": false
      },
      "maxItems": 3,
      "minItems": 1
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "kind": {
            "enum": [
              "material",
              "annotation"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "repository",
                "commit",
                "path"
              ],
              "additionalProperties": false
            },
            "maxItems": 8,
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "sources"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "associative",
              "annotates",
              "representation-of",
              "computation-dependency",
              "proof-premise"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "kind",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 0
    },
    "trails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            },
            "maxItems": 32,
            "minItems": 1
          },
          "origin": {
            "type": "object",
            "properties": {
              "trail": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "step": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            },
            "required": [
              "trail",
              "step"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "steps"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "minItems": 0
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+/[a-z][a-z0-9.-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "required": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "maxProperties": 16
          }
        },
        "required": [
          "namespace",
          "version",
          "required",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "minItems": 0
    },
    "provenance": {
      "type": "object",
      "properties": {
        "basis": {
          "const": "project-original/Unknown-v0.3"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "repository",
              "commit",
              "path"
            ],
            "additionalProperties": false
          },
          "maxItems": 8,
          "minItems": 0
        }
      },
      "required": [
        "basis",
        "author",
        "sources"
      ],
      "additionalProperties": false
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 16,
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "identity",
    "capabilities",
    "content",
    "relations",
    "trails",
    "extensions",
    "provenance",
    "residuals"
  ],
  "additionalProperties": false
}
